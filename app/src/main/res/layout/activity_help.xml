<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".HelpActivity"
    android:background="@android:color/black"> <!-- Esempio: sfondo nero per contrasto -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:errorEnabled="true"
        android:textColorHint="#CCCCCC"> <!-- Colore per il suggerimento (hint) -->

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Numero di telefono per emergenza"
            android:inputType="phone"
            android:textColor="@android:color/white" /> <!-- TESTO BIANCO -->

    </com.google.android.material.textfield.TextInputLayout>
    <!-- activity_help.xml -->



    <Button
        android:id="@+id/btnAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Invia Allarme WhatsApp" />

    <!-- ▼▼▼ TESTO SPOSTATO E MODIFICATO ▼▼▼ -->
    <!-- Questo testo ora mostrerà lo stato del pulsante o del GPS -->
    <TextView
        android:id="@+id/tvLocationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:textStyle="italic"
        android:textColor="@android:color/white"
        tools:text="Sei troppo lontano per inviare una segnalazione" />



    <!-- ▼▼▼ SEZIONE GPS CON TESTO BIANCO ▼▼▼ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="La tua posizione attuale:"
        android:textStyle="bold"
        android:textColor="@android:color/white" /> <!-- TESTO BIANCO -->

    <TextView
        android:id="@+id/tvLatitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="Latitudine: 45.4642"
        android:textColor="@android:color/white" /> <!-- TESTO BIANCO -->

    <TextView
        android:id="@+id/tvLongitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Longitudine: 9.1900"
        android:textColor="@android:color/white" /> <!-- TESTO BIANCO -->

    <TextView
        android:id="@+id/tvDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Sei a 5.2 Km dal parco &quot;La Favorita&quot;"
        android:textColor="@android:color/white" /> <!-- TESTO BIANCO -->

</LinearLayout>
